<?xml version="1.0" encoding="utf-8"?>
<!-- 왼쪽: 신호 목록 + 이벤트, 오른쪽: API 로그 (스타터 화면과 같은 배치) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="32dp">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/signal_title"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:text="@string/signal_subtitle"
                android:textSize="20sp" />

            <!-- 신호 줄은 코드에서 item_signal로 채운다 -->
            <LinearLayout
                android:id="@+id/signalList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/Label"
                android:layout_marginTop="16dp"
                android:text="@string/signal_events_label" />

            <TextView
                android:id="@+id/eventText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:textSize="24sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/refreshButton"
                    android:layout_width="wrap_content"
                    android:layout_height="96dp"
                    android:layout_marginEnd="16dp"
                    android:paddingHorizontal="32dp"
                    android:text="@string/refresh"
                    android:textSize="24sp" />

                <Button
                    android:id="@+id/resetButton"
                    android:layout_width="wrap_content"
                    android:layout_height="96dp"
                    android:paddingHorizontal="32dp"
                    android:text="@string/signal_reset"
                    android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="32dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/Label"
            android:layout_marginBottom="8dp"
            android:text="@string/log_label" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="16sp" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
