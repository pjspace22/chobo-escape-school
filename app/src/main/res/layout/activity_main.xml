<?xml version="1.0" encoding="utf-8"?>
<!-- 차량 화면은 가로가 넓으므로 왼쪽은 차량 값, 오른쪽은 API 로그 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="32dp">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:text="@string/subtitle"
                android:textSize="20sp" />

            <TextView
                style="@style/Label"
                android:text="@string/door_label" />

            <TextView
                android:id="@+id/doorValue"
                style="@style/Value"
                android:text="@string/unknown" />

            <TextView
                style="@style/Label"
                android:text="@string/brake_label" />

            <TextView
                android:id="@+id/brakeValue"
                style="@style/Value"
                android:text="@string/unknown" />

            <TextView
                style="@style/Label"
                android:text="@string/odometer_label" />

            <TextView
                android:id="@+id/odometerValue"
                style="@style/Value"
                android:text="@string/unknown" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 운전 중에도 누르기 쉽게 터치 영역을 크게 -->
                <Button
                    android:id="@+id/doorToggleButton"
                    android:layout_width="wrap_content"
                    android:layout_height="96dp"
                    android:layout_marginEnd="16dp"
                    android:enabled="false"
                    android:paddingHorizontal="32dp"
                    android:text="@string/door_toggle"
                    android:textSize="24sp" />

                <Button
                    android:id="@+id/refreshButton"
                    android:layout_width="wrap_content"
                    android:layout_height="96dp"
                    android:paddingHorizontal="32dp"
                    android:text="@string/refresh"
                    android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="32dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/Label"
            android:layout_marginBottom="8dp"
            android:text="@string/log_label" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="16sp" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
